# ============================================================================
# link-center environment configuration
#
# Copy to `.env` / `.dev.vars` for local development and set the same values
# as Cloudflare secrets for production:
#
#   wrangler secret put BREVO_API_KEY
#   wrangler secret put BREVO_SENDER_EMAIL
#   wrangler secret put BREVO_SENDER_NAME
#   wrangler secret put BREVO_WEBHOOK_SECRET
#   wrangler secret put CLICK_SALT
#
# NEVER commit real secrets.
# ============================================================================

# --- Brevo (https://app.brevo.com -> Settings -> API Keys) -----------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@link.ankb.qzz.io
BREVO_SENDER_NAME=Link Center

# Shared token that Brevo must present when calling /api/webhooks/brevo.
# Configure it in Brevo as the webhook URL token (recommended) or as the
# webhook auth token. Generate with:  openssl rand -hex 32
BREVO_WEBHOOK_SECRET=

# Random secret used to hash visitor fingerprints (IP + user agent) before
# storing click analytics. Generate with:  openssl rand -hex 32
CLICK_SALT=

# Optional: when set, the first-run /setup page additionally requires this
# token, so nobody can claim the admin account before you do. Recommended for
# internet-facing deployments.
SETUP_TOKEN=

# --- Optional overrides ----------------------------------------------------
# BREVO_API_BASE_URL=https://api.brevo.com/v3

# --- Local D1 (used by `wrangler dev`) -------------------------------------
# D1 database and KV namespace are created automatically on first run;
# see wrangler.toml.
