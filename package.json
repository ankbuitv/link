{
  "name": "link-center",
  "version": "1.0.0",
  "description": "Link & Email Control Center — Cloudflare Workers + D1 + KV + Brevo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "wrangler d1 execute link-center-db --local --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@eslint/js": "^9.29.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.29.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
